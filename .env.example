# AISstream.io - create 2 free API keys at https://aisstream.io (GitHub login).
# A single subscription cannot combine "watchlist worldwide + everything
# regional", hence two separate connections, each with its own key.
AISSTREAM_API_KEY_WATCHLIST=
AISSTREAM_API_KEY_REGIONS=

# Outside docker-compose: adjust host/credentials.
DATABASE_URL=postgresql+asyncpg://darkships:darkships@localhost:5432/darkships

# Hotspot regions (full position history is stored inside these).
# JSON list of {"name": ..., "bbox": [[latMin, lonMin], [latMax, lonMax]]}
AIS_REGIONS='[{"name": "Baltic & Gulf of Finland", "bbox": [[54.0, 9.5], [60.5, 30.5]]}, {"name": "North Sea & English Channel", "bbox": [[48.5, -6.0], [54.0, 8.0]]}, {"name": "Gibraltar & Alboran Sea", "bbox": [[34.5, -7.5], [37.5, 0.5]]}, {"name": "Eastern Med STS zone", "bbox": [[33.5, 14.0], [38.5, 27.0]]}, {"name": "Black Sea exit", "bbox": [[40.5, 26.5], [45.5, 40.0]]}, {"name": "Canary corridor", "bbox": [[15.0, -21.0], [30.0, -8.0]]}, {"name": "Gulf of Guinea", "bbox": [[-1.0, -6.0], [7.0, 10.0]]}, {"name": "Hormuz & Gulf of Oman", "bbox": [[22.5, 51.0], [27.5, 60.5]]}, {"name": "Singapore & Riau STS zone", "bbox": [[-2.0, 100.5], [4.0, 108.5]]}]'

# Subscribe globally: full history for watchlist + in-region ships only,
# everything else is a live in-memory snapshot (no disk growth).
AIS_WORLD_FEED=true

# Gap detection
GAP_THRESHOLD_HOURS=6
GAP_MIN_SOG_KNOTS=1.0

# Behaviour engine - auto-add flagged vessels to the watchlist (max 50 slots;
# manual entries are pinned and never evicted)
AUTO_WATCHLIST=true
SUGGESTION_MIN_SCORE=50
REGIONAL_GAP_HOURS=3

# Ingest throttling for ambient traffic, seconds/ship (watchlist is never throttled).
# We store every ship for locate/track; region = the 22 detector regions, world =
# everything else. Both coarse by default to cap disk.
REGION_THROTTLE_SECONDS=60
WORLD_THROTTLE_SECONDS=60

# Overpass matcher
DRIFT_MAX_NM=100

# Optional, step 7 - Global Fishing Watch (NOTE: non-commercial use only)
GFW_API_TOKEN=

# Auth / accounts (FastAPI-Users). AUTH_SECRET signs JWTs and the password-reset
# / verification tokens - set a long random value in production.
AUTH_SECRET=dev-insecure-change-me
FRONTEND_BASE_URL=http://localhost:5173

# Local mail. Under docker-compose these are set to the Mailpit service; the
# web inbox is at http://localhost:8025.
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_FROM=noreply@darkships.local

# Google login is DISABLED until both of these are filled in. Create OAuth
# credentials at https://console.cloud.google.com and set the redirect URI to
# http://localhost:8000/api/auth/google/callback
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Cold tier: position partitions older than POSITIONS_RETENTION_DAYS are
# exported to Parquet on S3-compatible storage, then dropped from Postgres.
# Locally these point at the bundled MinIO (set in docker-compose.yml, so you
# can leave them blank here). For production, use Cloudflare R2:
#   S3_ENDPOINT=https://<account_id>.r2.cloudflarestorage.com
#   S3_BUCKET=darkships-cold
#   S3_ACCESS_KEY_ID=<r2 access key>
#   S3_SECRET_ACCESS_KEY=<r2 secret>
#   S3_REGION=auto
# Leave blank to disable archiving (old partitions are then kept, not dropped).
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=
S3_REGION=auto

# Process role. The AIS ingester and the scheduler are singletons - run them in
# exactly ONE instance. Locally, leave this "all" (one process does everything).
# In production, scale the API with RUN_MODE=web (many replicas) and run ONE
# RUN_MODE=worker replica for ingest + scheduling + migrations.
#   all    = API + ingester + scheduler in one process (default, local dev)
#   web    = API only (safe to scale to N replicas)
#   worker = ingester + scheduler only, single replica
RUN_MODE=all
